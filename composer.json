{
    "type": "project",
    "name": "survos-sites/translation-server",
    "description": "Lingua Translation Server",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "ext-sqlite3": "*",
        "ext-xsl": "*",
        "ext-zip": "*",
        "api-platform/core": "^4.4.0 || ^5.0",
        "api-platform/doctrine-orm": "^4.2.8 || ^5.0",
        "api-platform/symfony": "^4.2.8 || ^5.0",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.7.1",
        "easycorp/easyadmin-bundle": "^4.29.16 || ^5.6",
        "fguillot/json-rpc": "^1.5.0",
        "inspector-apm/inspector-symfony": "^1.11.5",
        "jwage/phpamqplib-messenger": "dev-main@dev",
        "nelmio/cors-bundle": "^2.6.1",
        "nyholm/psr7": "^1.8.2",
        "otezvikentiy/json-rpc-api": "^5.3",
        "paragonie/sodium_compat": "^2.5.2",
        "phpdocumentor/reflection-docblock": "^5.6.7||^6.0",
        "phpstan/phpdoc-parser": "^2.3.5",
        "psr/log": "^3.0.2",
        "survos/api-grid-bundle": "^2.34.29",
        "survos/auth-bundle": "^2.34.29",
        "survos/babel-bundle": "^2.34.29",
        "survos/bunny-bundle": "^2.34.29",
        "survos/command-bundle": "^2.34.29",
        "survos/core-bundle": "^2.34.29",
        "survos/debug-utils": "^2.10.19",
        "survos/deployment-bundle": "^2.34.29",
        "survos/ez-bundle": "^2.34.29",
        "survos/fetch-bundle": "^2.34.29",
        "survos/field-bundle": "^2.34.29",
        "survos/jsonl-bundle": "^2.34.29",
        "survos/lingua-bundle": "^2.34.29",
        "survos/lingua-contracts": "^2.24.16",
        "survos/lingua-core": "^2.10.19",
        "survos/simple-datatables-bundle": "^2.34.29",
        "survos/state-bundle": "^2.34.29",
        "survos/tabler-bundle": "^2.34.29",
        "survos/translator-bundle": "^2.34.29",
        "symfony/asset": "^7.4||^8.1",
        "symfony/asset-mapper": "^7.4||^8.1",
        "symfony/console": "^7.4||^8.1",
        "symfony/doctrine-messenger": "^7.4||^8.1",
        "symfony/dotenv": "^7.4||^8.1",
        "symfony/expression-language": "^7.4||^8.1",
        "symfony/flex": "^2.11.0",
        "symfony/framework-bundle": "^7.4||^8.1",
        "symfony/http-client": "^7.4||^8.1",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/property-access": "^7.4||^8.1",
        "symfony/property-info": "^7.4||^8.1",
        "symfony/remote-event": "^7.4||^8.1",
        "symfony/runtime": "^7.4||^8.1",
        "symfony/security-bundle": "^7.4||^8.1",
        "symfony/serializer": "^7.4||^8.1",
        "symfony/string": "^7.4||^8.1",
        "symfony/translation": "^7.4||^8.1",
        "symfony/translation-contracts": "^3.7.1",
        "symfony/twig-bundle": "^7.4||^8.1",
        "symfony/ux-chartjs": "^3.5",
        "symfony/validator": "^7.4||^8.1",
        "symfony/webhook": "^7.4||^8.1",
        "symfony/yaml": "^7.4||^8.1",
        "twig/extra-bundle": "^3.29.0",
        "twig/string-extra": "^3.24.0",
        "vanderlee/php-sentence": "^1.0.8",
        "zenstruck/bytes": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "survos/installer": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": false,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "export": [
            "php -d memory_limit=2G bin/console app:export --zip --no-debug --batch=2500"
        ],
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "php -d memory_limit=512M bin/console cache:clear",
            "@auto-scripts"
        ],
        "diagram": "bin/console doctrine:diagram --filename=assets/db.svg --exclude=doctrine_migration_versions,messenger_messages"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true",
            "require": "^8.2"
        }
    },
    "require-dev": {
        "jawira/doctrine-diagram-bundle": "^2.0",
        "phpstan/phpstan": "^2.2.14",
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^7.4||^8.1",
        "symfony/css-selector": "^7.4||^8.1",
        "symfony/debug-bundle": "^7.4||^8.1",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/web-profiler-bundle": "^7.4||^8.1"
    }
}
