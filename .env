# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
#DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
DATABASE_URL=postgresql://postgres:docker@127.0.0.1:5434/lingua?serverVersion=18&charset=utf8
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

BING_KEY=
BING_KEY2=
BING_BACKUP=false
BING_LOCATION=eastus

TRANSLATION_CACHE_DSN="sqlite:/%kernel.project_dir%/translation.db"
#SCRAPER_CACHE_DSN="sqlite:/%kernel.project_dir%/translation.db"
SCRAPER_CACHE_DSN="sqlite:../scraper.db"
#SCRAPER_CACHE_DSN="sqlite:/tmp/scraper.db"



###> symfony/messenger ###
# PRODUCTION overrides MESSENGER_TRANSPORT_DSN with the shared RabbitMQ (see
# `dokku config lingua`), which is what survos_state.queue_driver: rabbitmq consumes for the
# per-transition transports. This default is the DEV value and stays Doctrine — see
# config/packages/survos_state.yaml for why dev and test deliberately do not follow prod.
MESSENGER_TRANSPORT_DSN=doctrine://messenger?auto_setup=true

# Used by survos_state in dev/test, and by any transport that should stay inspectable as rows
# regardless of what the async transitions use. Named to match `packages`, which made the same
# split first.
DOCTRINE_MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# from docker, dedicated postgres database for messages
MESSENGER_DATABASE_URL=postgresql://messenger:messenger@127.0.0.1:5435/messenger?serverVersion=18&charset=utf8

###< symfony/messenger ###

REDIS="redis://localhost:6379" # matches docker-compose.yml
TRANSLATOR_ENDPOINT=https://lingua.survos.com
PROXY=''

###> inspector-apm/inspector-symfony ###
INSPECTOR_INGESTION_KEY=
###< inspector-apm/inspector-symfony ###

#LIBRE_URL=http://localhost
LIBRE_API_KEY=
LIBRE_HOST=https://babel.survos.com


###> survos/bunny-bundle ###
BUNNY_API_KEY=
###< survos/bunny-bundle ###

#DEFAULT_TRANSPORT=async

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> survos/lingua-bundle ###
# Shared secret for the lingua API -- NOT babel/LibreTranslate, which needs no key.
# The SAME value belongs here and in every app that calls lingua (zm, bts, harvest, ...):
# clients send it as X-Api-Key, lingua compares against it.
# Empty means the check is disabled, which is the behaviour lingua has today. Set it on
# lingua and on every caller in the same deploy, or callers start getting 401s.
LINGUA_API_KEY=
# Base URI of the lingua server, for apps calling it. Empty falls back to
# https://lingua.survos.com. Set to https://lingua.wip to work against a local server.
LINGUA_BASE_URI=
# "rest" (default, empty means rest) or "rpc". rpc uses JSON-RPC at POST /api/v1 and turns a
# rejected payload into a real error -- an unknown engine, for instance, is refused up front
# instead of creating Targets that fail later inside the worker. Requires a lingua deployed
# with /api/v1, so flip it per app AFTER the server is out. Not auto-detected: probing costs a
# round trip and a silent fallback would hide a misconfigured server.
LINGUA_PROTOCOL=
###< survos/lingua-bundle ###

###> otezvikentiy/json-rpc-api ###
OV_JSON_RPC_API_SWAGGER_PATH=public/openapi/
OV_JSON_RPC_API_BASE_URL=http://localhost
OV_JSON_RPC_API_TEST_URL=http://localhost
OV_JSON_RPC_API_AUTH_TOKEN=
###< otezvikentiy/json-rpc-api ###

###> translation.completed webhook (survos-sites/mediary#8) ###
# Shared HMAC secret for the outbound translation.completed webhook. Every subscriber must be
# given the same value as LINGUA_WEBHOOK_SECRET in its own environment; lingua signs with it
# and the subscriber's Survos\Kit\Webhook parser verifies with it.
#
# Empty on purpose: an empty secret makes TranslationNotifier refuse to send rather than send
# unsigned. Set a real value in .env.local and in `dokku config:set` — never here.
# Generate one with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
LINGUA_WEBHOOK_SECRET=
###< translation.completed webhook ###
