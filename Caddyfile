{
	frankenphp
}

:{$PORT:80} {
	root * /app/public

	# No `encode` directive: lingua.survos.com is Cloudflare-proxied, and Cloudflare
	# compresses on the way to the browser regardless of what the origin sends.
	# Adding it here is a layer that can go wrong in transit -- confirmed live on
	# packages with zstd (valid at the origin, every asset broke in the browser with
	# net::ERR_CONTENT_DECODING_FAILED once it hit Cloudflare's edge).

	# Bulk translation POSTs from harvest/zm can be large -- the ash nginx snippet
	# for babel raised client_max_body_size to 25m for exactly this traffic, and
	# lingua is the other end of it.
	request_body {
		max_size 32MB
	}

	# Browsers ask for /favicon.ico unprompted on the first page view of every
	# session. Without a terminating route the request falls through to php_server
	# and Symfony answers it with a NotFoundHttpException -- the single noisiest
	# line in the production log, and never a real error. `handle` blocks are
	# mutually exclusive and evaluated in the order written, so this one ends the
	# request here: public/favicon.ico is served if it exists, otherwise 204, and
	# PHP is never booted either way.
	handle /favicon.ico {
		@missing not file
		respond @missing 204
		file_server
	}

	handle {
		php_server
	}
}
