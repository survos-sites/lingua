{
	# Worker mode: each worker boots the Symfony kernel once and then serves requests from it,
	# instead of booting it for every request. symfony/runtime >= 7.4 switches to its
	# FrankenPhpWorkerRunner by itself when FrankenPHP sets FRANKENPHP_WORKER, so this block is
	# the whole change (no runtime package). Services live for the life of the worker, which is
	# also what lets the in-process translation engine (App\Translation\BergamotBridge) load its
	# model once per worker rather than once per request.
	#
	# Runbook and the state-leak audit this needs: mono bu/deployment-bundle/docs/
	# frankenphp-migration.md ("Worker mode") and zm/docs/frankenphp-worker.md. Audited here
	# 2026-11-12: no function statics, no static properties; the three services that keep state
	# between calls (AmqpTranslationJobPublisher's connection, EngineAutoscaleListener's
	# throttle, TranslationCompletionNotifier's flag) are process-level on purpose or clear
	# themselves, and already live that way inside the messenger workers.
	#
	# num defaults low: this host is short of memory and every worker holds a booted kernel.
	# FRANKENPHP_LOOP_MAX restarts a worker after that many requests, which bounds any slow leak.
	# To go back to one kernel boot per request, replace this block with a bare `frankenphp`.
	frankenphp {
		worker {
			file /app/public/index.php
			name lingua
			num {$FRANKENPHP_NUM_WORKERS:2}
			env FRANKENPHP_LOOP_MAX {$FRANKENPHP_LOOP_MAX:500}
			env FRANKENPHP_RESET_KERNEL {$FRANKENPHP_RESET_KERNEL:0}
		}
		max_wait_time 15s
	}
}

:{$PORT:80} {
	root * /app/public

	# No `encode` directive: lingua.survos.com is Cloudflare-proxied, and Cloudflare
	# compresses on the way to the browser regardless of what the origin sends.
	# Adding it here is a layer that can go wrong in transit -- confirmed live on
	# packages with zstd (valid at the origin, every asset broke in the browser with
	# net::ERR_CONTENT_DECODING_FAILED once it hit Cloudflare's edge).

	# Bulk translation POSTs from harvest/zm can be large -- the ash nginx snippet
	# for babel raised client_max_body_size to 25m for exactly this traffic, and
	# lingua is the other end of it.
	request_body {
		max_size 32MB
	}

	# Browsers ask for /favicon.ico unprompted on the first page view of every
	# session. Without a terminating route the request falls through to php_server
	# and Symfony answers it with a NotFoundHttpException -- the single noisiest
	# line in the production log, and never a real error. `handle` blocks are
	# mutually exclusive and evaluated in the order written, so this one ends the
	# request here: public/favicon.ico is served if it exists, otherwise 204, and
	# PHP is never booted either way.
	handle /favicon.ico {
		@missing not file
		respond @missing 204
		file_server
	}

	handle {
		php_server
	}
}
